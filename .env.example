# Payload
DATABASE_URI=mongodb://127.0.0.1/payload-storage-bunny
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Bunny account API key (cache purge + bunny:deploy-edge-script CLI)
BUNNY_ACCOUNT_API_KEY=YOUR_ACCOUNT_API_KEY_HERE

# Storage zone (HTTP backend)
BUNNY_STORAGE_ZONE_NAME=YOUR_STORAGE_ZONE_NAME_HERE
BUNNY_STORAGE_API_KEY=YOUR_STORAGE_API_KEY_HERE
BUNNY_STORAGE_HOSTNAME=YOUR_STORAGE_HOSTNAME_HERE
BUNNY_STORAGE_TOKEN_SECURITY_KEY=YOUR_STORAGE_TOKEN_SECURITY_KEY_HERE

# Stream library
BUNNY_STREAM_LIBRARY_ID=YOUR_STREAM_LIBRARY_ID_HERE
BUNNY_STREAM_API_KEY=YOUR_STREAM_API_KEY_HERE
BUNNY_STREAM_HOSTNAME=YOUR_STREAM_HOSTNAME_HERE
BUNNY_STREAM_TOKEN_SECURITY_KEY=YOUR_STREAM_TOKEN_SECURITY_KEY_HERE

# S3-compatible storage zone (storage.s3 backend + presigned client uploads)
BUNNY_S3_STORAGE_ZONE_NAME=YOUR_S3_STORAGE_ZONE_NAME_HERE
BUNNY_S3_STORAGE_API_KEY=YOUR_S3_STORAGE_API_KEY_HERE
BUNNY_S3_STORAGE_HOSTNAME=YOUR_S3_STORAGE_HOSTNAME_HERE
BUNNY_S3_STORAGE_REGION=YOUR_S3_STORAGE_REGION_HERE

# Separate storage zone for signed-URL tests
BUNNY_SIGNED_STORAGE_ZONE_NAME=YOUR_SIGNED_STORAGE_ZONE_NAME_HERE
BUNNY_SIGNED_STORAGE_API_KEY=YOUR_SIGNED_STORAGE_API_KEY_HERE
BUNNY_SIGNED_STORAGE_HOSTNAME=YOUR_SIGNED_STORAGE_HOSTNAME_HERE
BUNNY_SIGNED_STORAGE_TOKEN_SECURITY_KEY=YOUR_SIGNED_STORAGE_TOKEN_SECURITY_KEY_HERE

# Separate stream library for signed-URL tests
BUNNY_SIGNED_STREAM_LIBRARY_ID=YOUR_SIGNED_STREAM_LIBRARY_ID_HERE
BUNNY_SIGNED_STREAM_API_KEY=YOUR_SIGNED_STREAM_API_KEY_HERE
BUNNY_SIGNED_STREAM_HOSTNAME=YOUR_SIGNED_STREAM_HOSTNAME_HERE
BUNNY_SIGNED_STREAM_TOKEN_SECURITY_KEY=YOUR_SIGNED_STREAM_TOKEN_SECURITY_KEY_HERE

# Deployed Edge Script for client uploads (bunny:deploy-edge-script)
BUNNY_EDGE_SCRIPT_URL=YOUR_EDGE_SCRIPT_URL_HERE
BUNNY_EDGE_SECRET=YOUR_EDGE_SECRET_HERE
