{
  "name": "@seshuk/payload-storage-bunny",
  "version": "2.1.1",
  "description": "Payload storage adapter for Bunny.net",
  "keywords": [
    "bunny",
    "bunny.net",
    "bunnycdn",
    "cloud",
    "cms",
    "payload",
    "payloadcms",
    "plugin",
    "storage",
    "tus",
    "typescript"
  ],
  "license": "MIT",
  "author": "Maxim Seshuk",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximseshuk/payload-storage-bunny.git"
  },
  "bin": {
    "payload-storage-bunny": "./dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/exports/client.js",
    "./media-preview": "./dist/mediaPreview/adapter.js",
    "./migrations": "./dist/migrations/index.js",
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./media-preview": {
        "import": "./dist/mediaPreview/adapter.js",
        "types": "./dist/mediaPreview/adapter.d.ts",
        "default": "./dist/mediaPreview/adapter.js"
      },
      "./migrations": {
        "import": "./dist/migrations/index.js",
        "types": "./dist/migrations/index.d.ts",
        "default": "./dist/migrations/index.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "dev": "dotenv -e .env -v PAYLOAD_DROP_DATABASE=false -- pnpm runts tests/dev.ts dev",
    "docs:check-links": "pnpm --dir docs check-links",
    "docs:dev": "pnpm --dir docs dev",
    "docs:openapi": "tsx scripts/build-openapi.ts",
    "docs:validate": "pnpm --dir docs validate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm clean && pnpm build",
    "runts": "dotenv -e .env -v NODE_OPTIONS=--no-deprecation -- tsx",
    "test": "dotenv -e .env -v NODE_ENV=development -- vitest run -c tests/vitest.config.ts",
    "test:coverage": "dotenv -e .env -v NODE_ENV=development -- vitest run -c tests/vitest.config.ts --coverage",
    "test:deploy-edge": "pnpm runts tests/manual/deployEdge.ts",
    "test:e2e": "dotenv -e .env -- pnpm runts tests/runE2E.ts",
    "test:e2e:ui": "dotenv -e .env -v UI_MODE=1 -- pnpm runts tests/runE2E.ts",
    "test:provision": "pnpm runts tests/manual/provision.ts",
    "test:unit": "vitest run -c tests/vitest.config.ts",
    "test:verify-edge": "pnpm runts tests/manual/verifyEdge.ts",
    "test:verify-s3": "pnpm runts tests/manual/verifyS3.ts",
    "test:watch": "dotenv -e .env -v NODE_ENV=development -- vitest -c tests/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@payloadcms/plugin-cloud-storage": "^3.83.0",
    "cac": "^7.0.0",
    "ky": "2.0.2",
    "s3mini": "0.9.5",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@next/env": "^16.2.10",
    "@payloadcms/db-mongodb": "^3.86.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/translations": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "@playwright/test": "^1.61.1",
    "@scalar/openapi-types": "^0.9.3",
    "@seshuk/payload-plugin-media-preview": "^1.1.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "mongodb-memory-server": "^11.2.0",
    "next": "16.2.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "payload": "^3.86.0",
    "pg": "8.20.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "6.1.3",
    "sanitize-filename": "1.6.3",
    "sharp": "0.32.6",
    "tsdown": "^0.22.7",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@payloadcms/translations": "^3.83.0",
    "@seshuk/payload-plugin-media-preview": "^1.0.0",
    "payload": "^3.83.0",
    "sanitize-filename": "1.6.3"
  },
  "peerDependenciesMeta": {
    "@seshuk/payload-plugin-media-preview": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.14.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
