{
  "name": "@seshuk/payload-storage-bunny",
  "version": "2.1.1",
  "description": "Payload storage adapter for Bunny.net",
  "author": "Maxim Seshuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximseshuk/payload-storage-bunny.git"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "cms",
    "plugin",
    "typescript",
    "bunny",
    "bunnycdn",
    "bunny.net",
    "cloud",
    "storage",
    "tus"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/exports/client.js",
    "./rsc": "./dist/exports/rsc.js",
    "./*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "cpy 'src/**/*.scss' dist --parents",
    "build:types": "tsc --project tsconfig.build.json",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "runts": "dotenv -e .env -v NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" -- node --no-deprecation --no-experimental-strip-types --import @swc-node/register/esm-register",
    "dev": "dotenv -e .env -v PAYLOAD_DROP_DATABASE=false -- pnpm runts tests/dev.ts dev",
    "test": "dotenv -e .env -v NODE_ENV=development -- vitest run -c tests/vitest.config.ts",
    "test:watch": "dotenv -e .env -v NODE_ENV=development -- vitest -c tests/vitest.config.ts",
    "test:coverage": "dotenv -e .env -v NODE_ENV=development -- vitest run -c tests/vitest.config.ts --coverage",
    "test:e2e": "dotenv -e .env -- pnpm runts tests/runE2E.ts",
    "test:e2e:ui": "dotenv -e .env -v UI_MODE=1 -- pnpm runts tests/runE2E.ts",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@payloadcms/plugin-cloud-storage": "^3.53.0",
    "ky": "1.14.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/env": "^15.4.8",
    "@payloadcms/db-mongodb": "^3.66.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "^3.66.0",
    "@payloadcms/plugin-cloud-storage": "^3.66.0",
    "@payloadcms/translations": "^3.66.0",
    "@payloadcms/ui": "^3.66.0",
    "@playwright/test": "^1.57.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.7.9",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.0.15",
    "chalk": "^5.6.2",
    "cpy-cli": "^6.0.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "mongodb-memory-server": "^10.4.0",
    "next": "15.4.8",
    "payload": "^3.66.0",
    "prettier": "^3.7.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "rimraf": "6.1.2",
    "sanitize-filename": "1.6.3",
    "sharp": "0.32.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "@payloadcms/translations": "^3.53.0",
    "payload": "^3.53.0",
    "sanitize-filename": "1.6.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://registry.npmjs.org/",
    "types": "./dist/index.d.ts"
  },
  "packageManager": "pnpm@11.12.0",
  "module": "./dist/index.js"
}