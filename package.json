{
  "name": "@seshuk/payload-storage-bunny",
  "version": "2.1.1",
  "description": "Payload storage adapter for Bunny.net",
  "keywords": [
    "bunny",
    "bunny.net",
    "bunnycdn",
    "cloud",
    "cms",
    "payload",
    "payloadcms",
    "plugin",
    "storage",
    "tus",
    "typescript"
  ],
  "license": "MIT",
  "author": "Maxim Seshuk",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximseshuk/payload-storage-bunny.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/exports/client.js",
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "cpy 'src/**/*.scss' dist --parents",
    "dev": "dotenv -e .env -v PAYLOAD_DROP_DATABASE=false -- pnpm runts tests/dev.ts dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm clean && pnpm build",
    "runts": "dotenv -e .env -v NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" -- node --no-deprecation --no-experimental-strip-types --import @swc-node/register/esm-register",
    "test": "dotenv -e .env -v NODE_ENV=development -- vitest run -c tests/vitest.config.ts",
    "test:coverage": "dotenv -e .env -v NODE_ENV=development -- vitest run -c tests/vitest.config.ts --coverage",
    "test:e2e": "dotenv -e .env -- pnpm runts tests/runE2E.ts",
    "test:e2e:ui": "dotenv -e .env -v UI_MODE=1 -- pnpm runts tests/runE2E.ts",
    "test:watch": "dotenv -e .env -v NODE_ENV=development -- vitest -c tests/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/plugin-cloud-storage": "^3.66.0",
    "ky": "2.0.2",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@next/env": "^16.2.10",
    "@payloadcms/db-mongodb": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/translations": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "@playwright/test": "^1.61.1",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "chalk": "^5.6.2",
    "cpy-cli": "^7.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "mongodb-memory-server": "^11.2.0",
    "next": "16.2.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "payload": "^3.86.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "6.1.3",
    "sanitize-filename": "1.6.3",
    "sharp": "0.32.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@payloadcms/translations": "^3.66.0",
    "payload": "^3.66.0",
    "sanitize-filename": "1.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.12.0"
}
