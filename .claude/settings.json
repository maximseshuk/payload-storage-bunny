{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git describe *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(pnpm install)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm list *)",
      "Bash(pnpm why *)",
      "Bash(pnpm outdated*)",
      "Bash(pnpm view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release view *)",
      "Bash(gh issue view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "extraKnownMarketplaces": {
    "seshuk": {
      "source": { "source": "github", "repo": "maximseshuk/payload-plugin-tooling" }
    },
    "payload-marketplace": {
      "source": { "source": "github", "repo": "payloadcms/payload" }
    }
  },
  "enabledPlugins": {
    "payload-plugin@seshuk": true,
    "payload@payload-marketplace": true
  }
}
