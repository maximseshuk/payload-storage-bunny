{
  "extends": "@seshuk/payload-plugin-tooling/tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "rootDir": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@seshuk/payload-storage-bunny": ["./src/index.ts"],
      "@seshuk/payload-storage-bunny/client": ["./src/client/index.ts"]
    },
    "emitDeclarationOnly": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./scripts/**/*.ts", "./tests/**/*.ts", "./tests/next-env.d.ts"],
  "exclude": ["./tests/app/**/*", "./tests/payload.config.ts"]
}
